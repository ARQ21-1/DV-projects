[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
depth 30
multiclock on

[engines]
smtbmc boolector

[script]
read_verilog -sv rtl/FIFO.v rtl/FIFO_memory.v rtl/wptr_full.v rtl/rptr_empty.v rtl/two_ff_sync.v formal/async_fifo_props.sv
prep -top Async_FIFO

[files]
rtl/FIFO.v
rtl/FIFO_memory.v
rtl/wptr_full.v
rtl/rptr_empty.v
rtl/two_ff_sync.v
formal/async_fifo_props.sv
